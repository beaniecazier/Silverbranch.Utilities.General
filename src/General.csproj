<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TimeStamp></TimeStamp>
    </PropertyGroup>
    
    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <OutputType>Library</OutputType>
<!--        <AllowUnsafeBlocks>false</AllowUnsafeBlocks>-->
<!--        <UseMauiEssentials>false</UseMauiEssentials>-->
<!--        <EnableDefaultCompileItems>true</EnableDefaultCompileItems>-->

        <Company>Silverbranch Codeworks</Company>
        <Authors>Tiabeanie Cazier</Authors>
        <Product>General Utility Codebase</Product>
        <Title>$(Company) $(Product)</Title>
        <AssemblyName>Utilities.General</AssemblyName>
        <RootNamespace>Gay.Silverbranch.$(AssemblyName)</RootNamespace>
        <PackageId>Gay.Silverbranch.pkg.$(AssemblyName)</PackageId>
        <PackageProjectUrl>silverbranch-codeworks.com</PackageProjectUrl>
<!--    <RepositoryUrl></RepositoryUrl>-->

        <PackageIcon>Icon.png</PackageIcon>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
        
        <VersionPrefix>1.0.0</VersionPrefix>
        <VersionSuffix></VersionSuffix>
        <PackageVersion>$(VersionPrefix)$(VersionSuffix)$(TimeStamp)</PackageVersion>
        <AssemblyVersion>$(VersionPrefix).0</AssemblyVersion>
        <FileVersion>$(VersionPrefix).0</FileVersion>

        <PackageReleaseNotes>
            # SILVERBRANCH CODEWORKS GENERAL UTILITY LIBRARY

            ## Version [1.1.0-alpha] - 2025-07-21

            **Type:** Alpha
            **Stability:** ⚠️ Experimental – Not recommended for production use.

            ---

            ### 🚧 Overview

            This alpha release introduces early implementations of planned features for version 1.0.0.

            > ⚠️ APIs and behavior may change without notice in future builds.

            > 💡 Use this release to explore upcoming features and provide feedback.

            ---

            ### ➕ New Features ➕

            - Baseline Commandline handling and service collection extension

            ---

            ### ⚠️ Known Issues / Limitations ️⚠️

            - []

            ---

            ### 🔗 Related Links 🔗

            - [Full Changelog](CHANGELOG.md#Version-100-alpha)
        </PackageReleaseNotes>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\Icon.png">
            <Pack>True</Pack>
            <PackagePath>.</PackagePath>
            <Link>Icon.png</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Include="..\README.md">
            <Pack>True</Pack>
            <PackagePath>.</PackagePath>
            <Link>README.md</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Include="..\LICENSE.txt">
            <Pack>True</Pack>
            <PackagePath>.</PackagePath>
            <Link>LICENSE.txt</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <Content Include="..\ReleaseNotes.md">
            <Pack>True</Pack>
            <PackagePath>.</PackagePath>
            <Link>ReleaseNotes.md</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Documentation\" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="CaseON" Version="1.4.0" />
      <PackageReference Include="CommandLineParser" Version="2.9.1" />
      <PackageReference Include="Humanizer" Version="3.0.0-beta.96" />
      <PackageReference Include="LanguageExt.Core" Version="5.0.0-beta-54" />
      <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="9.0.0" />
      <PackageReference Include="Serilog" Version="4.2.0" />
      <PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
      <PackageReference Include="Serilog.Enrichers.Environment" Version="3.0.1" />
      <PackageReference Include="Serilog.Enrichers.Process" Version="3.0.0" />
      <PackageReference Include="Serilog.Enrichers.Thread" Version="4.0.0" />
      <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    </ItemGroup>

</Project>
